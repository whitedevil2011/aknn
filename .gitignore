# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ── Virtual Environments ─────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ── Distribution / Packaging ─────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/

# ── Jupyter / Colab ──────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── AKNN Brain Save Files ────────────────────────────────────────
*.aknn
!sample.aknn

# ── Personal DNA (keep dna.json sample, ignore personal variants) ─
personal_dna.json
my_dna.json

# ── Environment Variables ─────────────────────────────────────────
.env
.env.local
*.env

# ── IDE / Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────
*.log
*.out
*.err
logs/

# ── Testing ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── PyTorch / ML artifacts ───────────────────────────────────────
*.pt
*.pth
*.ckpt
*.pkl
*.pickle

# ── PennyLane cache ──────────────────────────────────────────────
.pennylane/

# ── Misc ─────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
.cache/
tmp/
temp/
